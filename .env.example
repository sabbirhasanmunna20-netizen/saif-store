# ------------------------------------------------------------------
# N AURA — Environment Variables
# Copy this file to .env.local for local dev, and set the same
# keys in Vercel > Project Settings > Environment Variables.
# ------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/naura?retryWrites=true&w=majority

# Secret used to sign JWT session tokens (use a long random string)
JWT_SECRET=replace_with_a_long_random_string

# Admin bootstrap credentials (used by scripts/seed-admin.js)
ADMIN_NAME=N AURA Admin
ADMIN_EMAIL=admin@naura.com
ADMIN_PHONE=8801516557161
ADMIN_PASSWORD=change_this_password

# bKash receiving number shown to customers at checkout
BKASH_RECEIVE_NUMBER=01516557161
ADVANCE_PAYMENT_AMOUNT=100

# WhatsApp number (with country code, no +) that receives order alerts
ADMIN_WHATSAPP_NUMBER=8801516557161

# WhatsApp Cloud API (Meta) — used to auto-send order/TxnID alerts.
# Create an app at https://developers.facebook.com/ > WhatsApp product.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# OTP delivery — optional SMS gateway (e.g. a BD bulk SMS API).
# If left blank, OTPs are printed to the server console (dev mode only).
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
